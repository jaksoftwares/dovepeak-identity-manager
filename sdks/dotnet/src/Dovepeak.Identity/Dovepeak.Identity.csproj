<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dovepeak.Identity</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Dovepeak.Identity</PackageId>
    <Version>0.1.0</Version>
    <Authors>Dovepeak Digital Solutions</Authors>
    <Description>Dovepeak Identity for ASP.NET Core: one-line JWT bearer authentication with role and scope policies, optional token introspection, and a typed Management API client.</Description>
    <PackageTags>dovepeak;identity;oidc;oauth;jwt;authentication;authorization</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jaksoftwares/dovepeak-identity-manager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Dovepeak.Identity.Tests" />
  </ItemGroup>

</Project>
