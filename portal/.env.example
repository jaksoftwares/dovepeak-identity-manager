# Developer portal configuration. Every value is server-side only: none may use the NEXT_PUBLIC_ prefix.
# The portal is a backend-for-frontend: tokens stay on the server, the browser holds an opaque session cookie.

# Platform realm (developer accounts) and the portal's public OAuth client.
PLATFORM_ISSUER=http://localhost:8080/realms/dovepeak-platform
PORTAL_CLIENT_ID=dovepeak-portal
# Optional: where the server reaches the identity engine when the public URL is not reachable from it (containers).
# IDENTITY_INTERNAL_URL=http://keycloak:8080

APP_URL=http://localhost:3100
MANAGEMENT_API_URL=http://localhost:5080
SESSION_REDIS_URL=redis://:valkey_local_only@localhost:6379/2
