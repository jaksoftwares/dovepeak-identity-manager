# Local development environment for Dovepeak Identity.
# Copy to .env:   cp .env.example .env
# These values are for local development only. Never reuse them in any shared or production environment.

# PostgreSQL superuser (used only to initialise databases)
POSTGRES_SUPERUSER_PASSWORD=postgres_local_only

# Management API database
DOVEPEAK_DB_PASSWORD=dovepeak_local_only

# Keycloak database
KEYCLOAK_DB_PASSWORD=keycloak_local_only

# Keycloak bootstrap administrator (local only)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_only

# Management API service account in Keycloak (created by keycloak-bootstrap)
KEYCLOAK_MANAGEMENT_CLIENT_ID=dovepeak-management
KEYCLOAK_MANAGEMENT_CLIENT_SECRET=management_client_local_only

# Secret for API key digests (base64, at least 32 bytes). Generate for real deployments: openssl rand -base64 32
PLATFORM_API_KEY_DIGEST_KEY=ZG92ZXBlYWstbG9jYWwtb25seS1kaWdlc3Qta2V5LTE=

# Valkey (Redis-compatible cache)
VALKEY_PASSWORD=valkey_local_only

# Host ports (change if a port is already in use on your machine)
POSTGRES_HOST_PORT=5442
VALKEY_HOST_PORT=6379
KEYCLOAK_HOST_PORT=8080
KEYCLOAK_ADMIN_HOST_PORT=8081
KEYCLOAK_MANAGEMENT_HOST_PORT=9000
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
MANAGEMENT_API_HOST_PORT=5080
PORTAL_HOST_PORT=3100

# Edge rate limits, per client IP (requests per minute, plus burst).
# Production defaults (used when unset): email 5/min burst 5, credentials 30/min burst 20, general 600/min burst 200.
# Local development and the integration test suite use higher limits because every request comes from one IP.
EDGE_RATELIMIT_EMAIL_PER_MINUTE=120
EDGE_RATELIMIT_EMAIL_BURST=60
EDGE_RATELIMIT_CREDENTIALS_PER_MINUTE=1200
EDGE_RATELIMIT_CREDENTIALS_BURST=600
EDGE_RATELIMIT_GENERAL_PER_MINUTE=6000
EDGE_RATELIMIT_GENERAL_BURST=2000
