# Dovepeak Identity — production configuration. Copy to .env and replace every CHANGE_ME.
# Generate secrets with:  openssl rand -base64 32   (use letters and digits only where noted)
# Keep this file readable by root only:  chmod 600 .env

# ---------------------------------------------------------------- Hostnames (DNS A/AAAA records -> this server)
IDENTITY_HOST=auth.example.com
PORTAL_HOST=console.example.com
API_HOST=api.example.com
# Certificate expiry notices from Let's Encrypt
ACME_EMAIL=CHANGE_ME@example.com
# Rehearsal on a machine without public DNS: CADDY_LOCAL_CERTS=local_certs (Caddy's internal CA, not trusted by browsers)
CADDY_LOCAL_CERTS=

# ---------------------------------------------------------------- Secrets
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DOVEPEAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
VALKEY_PASSWORD=CHANGE_ME_letters_and_digits_only
KEYCLOAK_ADMIN_USERNAME=dovepeak-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_MANAGEMENT_CLIENT_SECRET=CHANGE_ME
# Base64, at least 32 bytes: openssl rand -base64 32
PLATFORM_API_KEY_DIGEST_KEY=CHANGE_ME
MAIL_RELAY_PASSWORD=CHANGE_ME_at_least_16_characters
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- Email provider (SMTP submission with STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Sender address; its domain needs SPF, DKIM and DMARC records for your provider.
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Dovepeak Identity
# Sending quotas (known limitation L-04)
MAIL_QUOTA_PER_RECIPIENT_PER_HOUR=5
MAIL_QUOTA_PER_RECIPIENT_PER_DAY=20
MAIL_QUOTA_PER_TENANT_PER_HOUR=500

# ---------------------------------------------------------------- Backups (pgBackRest, encrypted)
# Losing this passphrase makes every backup unreadable. Store it outside this server (password manager, vault).
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME
# posix = a Docker volume on this host (not enough on its own: copy it off-site), s3 = any S3-compatible storage (recommended).
BACKUP_REPO_TYPE=posix
BACKUP_REPO_PATH=/var/lib/pgbackrest
# BACKUP_REPO_TYPE=s3
# BACKUP_REPO_PATH=/dovepeak
# BACKUP_S3_BUCKET=
# BACKUP_S3_ENDPOINT=s3.eu-central-1.amazonaws.com
# BACKUP_S3_REGION=eu-central-1
# BACKUP_S3_KEY=
# BACKUP_S3_KEY_SECRET=
# BACKUP_S3_URI_STYLE=host   (path for MinIO and some providers)
BACKUP_RETENTION_FULL=4
FULL_BACKUP_DAYS=7
DIFF_BACKUP_HOURS=24

# ---------------------------------------------------------------- Edge rate limits per client IP (production defaults)
EDGE_RATELIMIT_EMAIL_PER_MINUTE=5
EDGE_RATELIMIT_EMAIL_BURST=5
EDGE_RATELIMIT_CREDENTIALS_PER_MINUTE=30
EDGE_RATELIMIT_CREDENTIALS_BURST=20
EDGE_RATELIMIT_GENERAL_PER_MINUTE=600
EDGE_RATELIMIT_GENERAL_BURST=200

# ---------------------------------------------------------------- Alerting
# Path to an Alertmanager configuration with a real receiver (see docs/operations/observability.md)
ALERTMANAGER_CONFIG=../observability/alertmanager.yml
