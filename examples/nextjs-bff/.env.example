# Generate a working .env.local for the local stack with:
#   dotnet run --project tools/Dovepeak.Identity.DevTool -- demo-setup
#
# Every value here is server-side only. None of them may use the NEXT_PUBLIC_ prefix:
# the browser never sees the client secret or any token.

DOVEPEAK_ISSUER=http://localhost:8080/realms/dp-demo
DOVEPEAK_CLIENT_ID=demo-bff
DOVEPEAK_CLIENT_SECRET=replace-me
APP_URL=http://localhost:3000
SESSION_REDIS_URL=redis://:valkey_local_only@localhost:6379/1
PROTECTED_API_URL=http://localhost:5301
